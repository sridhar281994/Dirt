build	Build with Buildozer	# Persist Gradle wrapper/caches inside the workspace so they can be cached between runs.
build	Build with Buildozer	export GRADLE_USER_HOME="$PWD/.gradle"
build	Build with Buildozer	
build	Build with Buildozer	# Some runners/environments can't reach archive.apache.org reliably.
build	Build with Buildozer	# Install Ant locally (or no-op if already installed) and make sure
build	Build with Buildozer	# buildozer.spec points to it so Buildozer doesn't attempt a download.
build	Build with Buildozer	if command -v ant >/dev/null 2>&1; then
build	Build with Buildozer	  echo "Ant already present: $(command -v ant)"
build	Build with Buildozer	elif command -v apt-get >/dev/null 2>&1; then
build	Build with Buildozer	  apt-get update
build	Build with Buildozer	  apt-get install -y ant
build	Build with Buildozer	fi
build	Build with Buildozer	sed -i 's|^#android.ant_path =.*|android.ant_path = /usr|' buildozer.spec || true
build	Build with Buildozer	
build	Build with Buildozer	# The Android Gradle Plugin can run out of heap during packaging (e.g. :packageDebug),
build	Build with Buildozer	# especially when bundling large AARs (Agora full-sdk, etc.). Increase Gradle/JVM heap.
build	Build with Buildozer	# (If the runner has enough RAM, this prevents java.lang.OutOfMemoryError.)
build	Build with Buildozer	export ORG_GRADLE_JVMARGS="-Xmx4g -XX:MaxMetaspaceSize=1g -Dfile.encoding=UTF-8"
build	Build with Buildozer	export GRADLE_OPTS="-Dorg.gradle.jvmargs=$ORG_GRADLE_JVMARGS"
build	Build with Buildozer	export JAVA_TOOL_OPTIONS="$ORG_GRADLE_JVMARGS"
build	Build with Buildozer	
build	Build with Buildozer	# Gradle wrapper downloads sometimes fail transiently in CI (e.g. GitHub 504).
build	Build with Buildozer	# Retry a few times before failing the workflow.
build	Build with Buildozer	for attempt in 1 2 3; do
build	Build with Buildozer	  echo "Buildozer attempt ${attempt}/3"
build	Build with Buildozer	  if yes | buildozer android debug; then
build	Build with Buildozer	    break
build	Build with Buildozer	  fi
build	Build with Buildozer	  if [ "$attempt" -lt 3 ]; then
build	Build with Buildozer	    sleep_seconds=$((attempt * 45))
build	Build with Buildozer	    echo "Build failed; retrying in ${sleep_seconds}s..."
build	Build with Buildozer	    sleep "${sleep_seconds}"
build	Build with Buildozer	  else
build	Build with Buildozer	    echo "Build failed after 3 attempts."
build	Build with Buildozer	    exit 1
build	Build with Buildozer	  fi
build	Build with Buildozer	done
