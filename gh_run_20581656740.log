build	Build with Buildozer	2025-12-29T20:19:25.9880465Z  '  echo "Ant already present: $(command -v ant)"\n'
build	Build with Buildozer	2025-12-29T20:19:25.9880959Z  'elif command -v apt-get >/dev/null 2>&1; then\n'
