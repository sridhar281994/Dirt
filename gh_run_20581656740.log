build	Build with Buildozer	2025-12-29T20:19:25.9885888Z  '# (If the runner has enough RAM, this prevents java.lang.OutOfMemoryError.)\n'
build	Build with Buildozer	2025-12-29T20:19:25.9886810Z  'export ORG_GRADLE_JVMARGS="-Xmx4g -XX:MaxMetaspaceSize=1g '
