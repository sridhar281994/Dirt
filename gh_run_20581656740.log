build	Build with Buildozer	2025-12-29T20:19:25.9888407Z  'export JAVA_TOOL_OPTIONS="$ORG_GRADLE_JVMARGS"\n'
build	Build with Buildozer	2025-12-29T20:19:25.9888931Z  '\n'
build	Build with Buildozer	2025-12-29T20:19:25.9889367Z  '# Gradle wrapper downloads sometimes fail transiently in CI (e.g. GitHub '
build	Build with Buildozer	2025-12-29T20:19:25.9889942Z  '504).\n'
build	Build with Buildozer	2025-12-29T20:19:25.9890300Z  '# Retry a few times before failing the workflow.\n'
build	Build with Buildozer	2025-12-29T20:19:25.9890775Z  'for attempt in 1 2 3; do\n'
build	Build with Buildozer	2025-12-29T20:19:25.9891186Z  '  echo "Buildozer attempt ${attempt}/3"\n'
